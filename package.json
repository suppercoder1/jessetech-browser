{
  "name": "jessetech-browser",
  "version": "0.1.0",
  "description": "Branded Electron shell for SearxNG",
  "main": "app/main.js",
  "author": "JesseTech",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^41.0.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "nl.jessetech.browser",
    "productName": "JesseTech Browser",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "files": [
      "app/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "app/assets/icon.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "app/assets/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "app/assets/icon.png"
    }
  }
}
